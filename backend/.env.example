# Copy to .env for local work. A blank value counts as unset:
# dev falls back to its default, prod refuses to start if the variable is required.

# Chooses the environment: config.settings.dev or config.settings.prod.
# Required everywhere, with no default. A variable set on the host wins over this file.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Signing key for sessions and JWTs. Required in prod, with its own random value of at least 50 characters. This one is for dev only.
DJANGO_SECRET_KEY=dev-only-not-secret
# true or false. Dev only, default true. Prod is always off.
DJANGO_DEBUG=true
# Comma-separated hostnames. Required in prod. Dev default: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# How many proxies sit in front of the app: 0 for none. Required in prod, unused in dev.
# Login limits read the client's address using this count, so a wrong value lets clients forge it.
DJANGO_NUM_PROXIES=
# postgres://USER:PASSWORD@HOST:PORT/NAME. Required in prod. Dev default: postgres://localhost:5432/nesma
# Local work and prod share the Neon main branch. The app connects through its pooled (-pooler) host.
# Add connect_timeout=5 to the query string, so a dead database fails fast.
DATABASE_URL=
# The same database on its direct host. manage.py migrate uses this, and falls back to DATABASE_URL if blank.
# Add connect_timeout=5 here too, so migrate fails fast against a dead database.
DIRECT_URL=
# Neon test branch, direct host. Required by pytest, which builds a temporary database there.
TEST_DATABASE_URL=
# Comma-separated origins including scheme. Required in prod. Dev default: http://localhost:5173,http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# HSTS max-age in seconds. Prod only, default 3600. Raise to 31536000 once HTTPS works across the domain.
DJANGO_SECURE_HSTS_SECONDS=
